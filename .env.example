# PulseOps configuration. Copy to `.env` and adjust. Never commit `.env`.
# Every variable is validated at startup (src/server/env.ts); a bad value stops
# the process with a message naming it.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public origin of the web app: used in email links, the CSRF check, and to
# decide whether cookies are `Secure`. Use https:// in production.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://pulseops:pulseops@localhost:5432/pulseops
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# ── Authentication ───────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30
# false = accounts can only be created through an invitation.
ALLOW_SIGNUP=true
# Reverse proxies in front of the app that append to X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# ── Monitoring ───────────────────────────────────────────────────────────────
MONITOR_MIN_INTERVAL_SECONDS=30
MONITOR_MAX_PER_ORG=100
# Comma-separated host[:port] entries exempt from the private-network block.
# Leave empty in production. The value below exists only so local monitors can
# reach the bundled demo target simulator. See docs/security.md.
MONITOR_ALLOWED_PRIVATE_HOSTS=localhost:4010
CHECK_RETENTION_DAYS=30
WORKER_CONCURRENCY=20
SCHEDULER_TICK_MS=2000
# 0 disables the worker's HTTP health endpoint.
WORKER_HEALTH_PORT=0

# ── Email notifications (optional) ───────────────────────────────────────────
# Unset: notifications are still recorded in the delivery log as "Not sent".
# Local mail catcher (docker compose): smtp://localhost:1025
SMTP_URL=
EMAIL_FROM=PulseOps <alerts@pulseops.localhost>
NOTIFICATION_MAX_PER_HOUR=60

# ── AI incident assistant (optional, off by default) ─────────────────────────
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_OUTPUT_TOKENS=6000
AI_RATE_LIMIT_PER_HOUR=10

# ── Demo and tests ───────────────────────────────────────────────────────────
DEMO_TARGETS_URL=http://localhost:4010
# SEED_DEMO_PASSWORD=pulseops-demo-2026
# TEST_DATABASE_URL=postgresql://pulseops:pulseops@localhost:5432/pulseops_test
